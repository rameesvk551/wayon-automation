---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Meltiox — WhatsApp Marketing, Sales & Commerce Automation Platform">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Inter', sans-serif; font-size: 14px; color: #1a1a1a; background: #fff; overflow-x: hidden; }

      /* ══════════ ANNOUNCEMENT BAR ══════════ */
      .topbar { background: linear-gradient(135deg, #0a4f3f 0%, #0d6b4f 100%); color: #fff; text-align: center; padding: 10px 20px; font-size: 12.5px; font-weight: 500; display: flex; align-items: center; justify-content: center; gap: 10px; }
      .topbar .badge { background: rgba(37,211,102,0.2); border: 1px solid rgba(37,211,102,0.4); padding: 3px 10px; border-radius: 50px; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; white-space: nowrap; }
      .topbar a { color: #4dd9a0; text-decoration: underline; margin-left: 4px; font-weight: 600; }

      /* ══════════ NAVIGATION ══════════ */
      nav { display: flex; align-items: center; justify-content: space-between; padding: 14px 40px; background: rgba(255,255,255,0.95); backdrop-filter: blur(20px); border-bottom: 1px solid #e8e8e8; position: sticky; top: 0; z-index: 100; }
      .nav-logo { font-size: 22px; font-weight: 800; color: #0a4f3f; display: flex; align-items: center; gap: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
      .nav-logo svg { width: 28px; height: 28px; }
      .nav-links { display: flex; align-items: center; gap: 28px; }
      .nav-links a { color: #444; font-size: 13px; text-decoration: none; font-weight: 500; transition: color 0.2s; }
      .nav-links a:hover { color: #0a4f3f; }
      .nav-right { display: flex; align-items: center; gap: 12px; }
      .btn-demo { border: 1.5px solid #25d366; color: #0a4f3f; padding: 8px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; background: transparent; text-decoration: none; transition: all 0.2s; }
      .btn-demo:hover { background: rgba(37,211,102,0.08); }
      .btn-green { background: #25d366; color: #fff; padding: 12px 28px; border-radius: 8px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.2s; }
      .btn-green:hover { background: #1fb855; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(37,211,102,0.3); }
      .btn-outline { background: #fff; color: #0a4f3f; padding: 11px 26px; border-radius: 8px; font-size: 14px; font-weight: 600; border: 1.5px solid #0a4f3f; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.2s; }
      .btn-outline:hover { background: #f0faf5; }

      /* ══════════ HERO ══════════ */
      .hero { background: linear-gradient(135deg, #f0faf5 0%, #e6f7ef 40%, #f5f5f0 100%); padding: 70px 40px 50px; display: flex; align-items: center; gap: 40px; min-height: 520px; position: relative; z-index: 2; }
      .hero-left { flex: 1; min-width: 280px; }
      .hero-left h1 { font-size: 38px; font-weight: 900; color: #0a4f3f; line-height: 1.15; margin-bottom: 22px; }
      .hero-left h1 .gradient-text { background: linear-gradient(135deg, #25d366, #0a4f3f); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
      .hero-left > p { font-size: 15.5px; color: #555; line-height: 1.7; margin-bottom: 28px; max-width: 500px; }
      .hero-btns { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 28px; }
      .hero-trust { display: flex; gap: 20px; flex-wrap: wrap; }
      .hero-trust-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #555; font-weight: 500; background: #fff; padding: 6px 14px; border-radius: 50px; border: 1px solid #e0e0e0; }
      .hero-trust-item .icon { font-size: 15px; }
      .hero-visual { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; }

      /* ══════════ MARQUEE ══════════ */
      .marquee-section { background: #faf7f2; border-top: 1px solid #ede8e0; border-bottom: 1px solid #ede8e0; padding: 22px 40px; overflow: hidden; }
      .marquee-label { text-align: center; font-size: 11px; color: #999; text-transform: uppercase; letter-spacing: 2px; font-weight: 600; margin-bottom: 16px; }
      .marquee-track { display: flex; align-items: center; justify-content: center; gap: 44px; flex-wrap: wrap; }
      .marquee-track span { font-size: 15px; font-weight: 700; color: #888; letter-spacing: 0.3px; white-space: nowrap; }

      /* ══════════ FEATURE TABS ══════════ */
      .features-section { padding: 70px 40px; background: #fff; }
      .section-center { text-align: center; max-width: 700px; margin: 0 auto 40px; }
      .section-badge { display: inline-flex; align-items: center; gap: 6px; background: linear-gradient(135deg, rgba(37,211,102,0.1), rgba(10,79,63,0.08)); border: 1px solid rgba(37,211,102,0.25); color: #0a4f3f; font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; padding: 6px 16px; border-radius: 50px; margin-bottom: 14px; }
      .section-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #25d366; animation: badgePulse 2s ease-in-out infinite; }
      @keyframes badgePulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.7); } }
      .section-h { font-size: 30px; font-weight: 800; color: #1a1a1a; margin-bottom: 14px; line-height: 1.25; }
      .section-h .highlight { background: linear-gradient(135deg, #25d366, #0a4f3f); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
      .section-p { font-size: 14.5px; color: #666; line-height: 1.7; }

      .tabs-nav { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin-bottom: 40px; }
      .tab-btn { padding: 10px 22px; border-radius: 50px; border: 1.5px solid #e0e0e0; background: #fff; color: #555; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.25s; }
      .tab-btn:hover { border-color: #25d366; color: #0a4f3f; }
      .tab-btn.active { background: #0a4f3f; color: #fff; border-color: #0a4f3f; }
      .tab-panel { display: none; animation: fadeTab 0.4s ease; }
      .tab-panel.active { display: flex; }
      @keyframes fadeTab { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
      .tab-panel { gap: 50px; align-items: center; }
      .tab-text { flex: 1; }
      .tab-text h3 { font-size: 24px; font-weight: 800; color: #1a1a1a; margin-bottom: 14px; line-height: 1.3; }
      .tab-text p { font-size: 14px; color: #555; line-height: 1.7; margin-bottom: 20px; }
      .tab-metrics { display: flex; gap: 24px; margin-bottom: 24px; flex-wrap: wrap; }
      .tab-metric { text-align: center; }
      .tab-metric .val { font-size: 28px; font-weight: 800; color: #25d366; }
      .tab-metric .lbl { font-size: 10px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }
      .tab-visual { flex: 1; display: flex; justify-content: center; }
      .tab-list { list-style: none; }
      .tab-list li { padding: 8px 0 8px 26px; position: relative; font-size: 13.5px; color: #444; border-bottom: 1px solid #f0f0f0; line-height: 1.5; }
      .tab-list li:last-child { border-bottom: none; }
      .tab-list li::before { content: ''; position: absolute; left: 0; top: 14px; width: 16px; height: 16px; background: #25d366; border-radius: 50%; }
      .tab-list li::after { content: '✓'; position: absolute; left: 3px; top: 12px; color: #fff; font-size: 9px; font-weight: 700; }

      /* ══════════ ROI CALCULATOR ══════════ */
      .roi-section { padding: 70px 40px; background: linear-gradient(135deg, #f0faf5, #e8f5ee); }
      .roi-box { max-width: 900px; margin: 0 auto; background: #fff; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.08); padding: 40px; display: flex; gap: 50px; align-items: flex-start; }
      .roi-inputs { flex: 1; }
      .roi-inputs label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 6px; margin-top: 18px; }
      .roi-inputs label:first-child { margin-top: 0; }
      .roi-inputs input[type="range"] { width: 100%; accent-color: #25d366; height: 6px; }
      .roi-val { font-size: 14px; color: #0a4f3f; font-weight: 700; }
      .roi-results { flex: 1; background: linear-gradient(135deg, #0a4f3f, #0d6b4f); border-radius: 16px; padding: 30px; color: #fff; }
      .roi-results h4 { font-size: 16px; font-weight: 700; margin-bottom: 20px; color: #4dd9a0; }
      .roi-result-item { margin-bottom: 16px; }
      .roi-result-item .label { font-size: 12px; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 0.5px; }
      .roi-result-item .value { font-size: 30px; font-weight: 800; }
      .roi-result-item .sub { font-size: 11px; color: rgba(255,255,255,0.5); }

      /* ══════════ PHONE MOCKUPS ══════════ */
      .phone-device { position: relative; width: 280px; margin: 0 auto; filter: drop-shadow(0 30px 60px rgba(0,0,0,0.25)); }
      .phone-device-body { position: relative; background: linear-gradient(145deg, #2a2a2a 0%, #1a1a1a 50%, #111 100%); border-radius: 44px; padding: 14px; border: 1px solid rgba(255,255,255,0.08); }
      .phone-device-body::before { content: ''; position: absolute; left: -3px; top: 100px; width: 3px; height: 30px; background: linear-gradient(180deg, #333, #222, #333); border-radius: 2px 0 0 2px; box-shadow: 0 38px 0 0 #2a2a2a, 0 60px 0 0 #2a2a2a; }
      .phone-device-body::after { content: ''; position: absolute; right: -3px; top: 130px; width: 3px; height: 50px; background: linear-gradient(180deg, #333, #222, #333); border-radius: 0 2px 2px 0; }
      .phone-device-screen { position: relative; border-radius: 32px; overflow: hidden; background: #000; }
      .phone-device-reflection { position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 32px; background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 40%, transparent 60%, rgba(255,255,255,0.02) 100%); pointer-events: none; z-index: 5; }
      .whatsapp-mockup-img { width: 100%; height: 500px; object-fit: cover; object-position: top; display: block; }
      .phone-speaker { position: absolute; top: 4px; left: 50%; transform: translateX(-50%); width: 40px; height: 4px; background: #222; border-radius: 4px; z-index: 2; }

      /* ══════════ MAC WINDOW ══════════ */
      .mac-window { background: #fff; border-radius: 18px; overflow: hidden; box-shadow: 0 30px 80px rgba(0,0,0,0.12), 0 10px 30px rgba(37,211,102,0.1); border: 1px solid rgba(0,0,0,0.08); width: 100%; max-width: 800px; animation: floatImg 6s ease-in-out infinite; transition: transform 0.3s ease; }
      .mac-window:hover { transform: translateY(-4px) scale(1.01); animation-play-state: paused; }
      .mac-header { background: #f8f9fa; padding: 12px 16px; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #eef0f2; }
      .mac-dot { width: 10px; height: 10px; border-radius: 50%; }
      .mac-dot.r { background: #ff5f56; border: 1px solid #e0443e; }
      .mac-dot.y { background: #ffbd2e; border: 1px solid #dea123; }
      .mac-dot.g { background: #27c93f; border: 1px solid #1aab29; }
      @keyframes floatImg { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

      /* ══════════ PHONE FLOW ══════════ */
      .phone-flow { display: flex; align-items: center; justify-content: center; gap: 24px; padding: 20px 0; }
      .phone-flow .phone-device { width: 280px; flex-shrink: 0; }
      .phone-flow .phone-speaker { display: none; }

      /* ══════════ SHOWCASE FEATURE ROWS ══════════ */
      .feature { padding: 60px 40px; display: flex; align-items: center; gap: 60px; }
      .feature.alt { background: #f8fdf9; flex-direction: row-reverse; }
      .feature-text { flex: 1; }
      .feature-text h2 { font-size: 24px; font-weight: 800; color: #1a1a1a; line-height: 1.3; margin-bottom: 14px; }
      .feature-text h2 .accent { color: #0a4f3f; }
      .feature-text > p { font-size: 14.5px; color: #555; line-height: 1.75; margin-bottom: 20px; }
      .feature-text ul { list-style: none; }
      .feature-text ul li { padding: 8px 0 8px 26px; position: relative; font-size: 13.5px; color: #444; border-bottom: 1px solid #f0f0f0; line-height: 1.5; }
      .feature-text ul li:last-child { border-bottom: none; }
      .feature-text ul li::before { content: ''; position: absolute; left: 0; top: 14px; width: 16px; height: 16px; background: #25d366; border-radius: 50%; }
      .feature-text ul li::after { content: '✓'; position: absolute; left: 3px; top: 12px; color: #fff; font-size: 9px; font-weight: 700; }
      .feature-img { flex: 0 0 auto; display: flex; justify-content: center; align-items: center; position: relative; width: 100%; }
      .btn-try { display: inline-block; margin-top: 20px; background: #25d366; color: #fff; padding: 11px 26px; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; transition: all 0.2s; }
      .btn-try:hover { background: #1fb855; }

      /* ══════════ INDUSTRY GRID ══════════ */
      .industry-section { padding: 70px 40px; background: #fff; }
      .industry-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; max-width: 1100px; margin: 0 auto; }
      .industry-card { background: #fff; border: 1.5px solid #e8e8e8; border-radius: 16px; padding: 28px 24px; transition: all 0.3s; cursor: default; }
      .industry-card:hover { border-color: #25d366; transform: translateY(-4px); box-shadow: 0 12px 30px rgba(37,211,102,0.12); }
      .industry-card .ic-icon { font-size: 32px; margin-bottom: 14px; }
      .industry-card h4 { font-size: 16px; font-weight: 700; color: #1a1a1a; margin-bottom: 8px; }
      .industry-card p { font-size: 12.5px; color: #666; line-height: 1.6; }

      /* ══════════ STATS BAR ══════════ */
      .stats { background: linear-gradient(135deg, #0a4f3f, #0d6b4f); padding: 44px 40px; display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 20px; }
      .stat { text-align: center; }
      .stat .num { font-size: 42px; font-weight: 900; color: #fff; line-height: 1; }
      .stat .lbl { font-size: 12.5px; color: rgba(255,255,255,0.75); margin-top: 6px; max-width: 140px; }
      .stat-div { width: 1px; height: 60px; background: rgba(255,255,255,0.2); }

      /* ══════════ FAQ ══════════ */
      .faq-section { padding: 70px 40px; background: #f8fdf9; }
      .faq-tabs { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-bottom: 30px; }
      .faq-tab { padding: 8px 18px; border-radius: 50px; border: 1.5px solid #d0d0d0; background: #fff; color: #555; font-size: 12.5px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
      .faq-tab:hover { border-color: #25d366; color: #0a4f3f; }
      .faq-tab.active { background: #0a4f3f; color: #fff; border-color: #0a4f3f; }
      .faq-list { max-width: 780px; margin: 0 auto; }
      .faq-item { background: #fff; border: 1px solid #e8e8e8; border-radius: 12px; margin-bottom: 10px; overflow: hidden; transition: all 0.2s; }
      .faq-item:hover { border-color: #c0e8d0; }
      .faq-q { padding: 18px 22px; font-size: 14px; font-weight: 600; color: #1a1a1a; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
      .faq-q::after { content: '+'; font-size: 20px; color: #25d366; font-weight: 700; transition: transform 0.3s; }
      .faq-item.open .faq-q::after { transform: rotate(45deg); }
      .faq-a { padding: 0 22px 18px; font-size: 13px; color: #666; line-height: 1.7; display: none; }
      .faq-item.open .faq-a { display: block; }

      /* ══════════ BOTTOM CTA ══════════ */
      .get-started { background: linear-gradient(135deg, #0a4f3f, #0d6b4f); padding: 60px 40px; text-align: center; color: #fff; }
      .get-started h2 { font-size: 32px; font-weight: 900; margin-bottom: 14px; }
      .get-started p { font-size: 15px; color: rgba(255,255,255,0.8); margin-bottom: 8px; max-width: 600px; margin-left: auto; margin-right: auto; }
      .get-started-tags { display: flex; justify-content: center; gap: 28px; margin: 24px 0 30px; flex-wrap: wrap; }
      .gs-tag { font-size: 13px; color: rgba(255,255,255,0.85); display: flex; align-items: center; gap: 6px; }
      .gs-tag::before { content: '●'; color: #25d366; font-size: 10px; }
      .btn-white { background: #fff; color: #0a4f3f; padding: 14px 36px; border-radius: 8px; font-size: 15px; font-weight: 700; border: none; cursor: pointer; display: inline-block; text-decoration: none; transition: all 0.2s; }
      .btn-white:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.15); }

      /* ══════════ FOOTER ══════════ */
      footer { background: #fff; border-top: 1px solid #e8e8e8; padding: 50px 40px 24px; }
      .footer-grid { display: grid; grid-template-columns: 240px 1fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 36px; }
      .footer-logo { font-size: 22px; font-weight: 800; color: #0a4f3f; margin-bottom: 12px; text-transform: uppercase; }
      .footer-logo span { color: #25d366; }
      .footer-desc { font-size: 12.5px; color: #666; line-height: 1.6; margin-bottom: 14px; }
      .footer-social { display: flex; gap: 10px; }
      .social-icon { width: 32px; height: 32px; background: #f0f0f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; cursor: pointer; transition: all 0.2s; }
      .social-icon:hover { background: #25d366; color: #fff; }
      .footer-col h4 { font-size: 13px; font-weight: 700; color: #1a1a1a; margin-bottom: 14px; text-transform: uppercase; letter-spacing: 0.5px; }
      .footer-col a { display: block; font-size: 12.5px; color: #666; text-decoration: none; margin-bottom: 8px; transition: color 0.2s; }
      .footer-col a:hover { color: #0a4f3f; }
      .footer-bottom { border-top: 1px solid #e8e8e8; padding-top: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
      .footer-bottom p { font-size: 12px; color: #999; }

      /* ══════════ RESPONSIVE ══════════ */
      @media (max-width: 992px) {
        nav { padding: 14px 20px; }
        .nav-links { display: none; }
        .hero, .feature, .feature.alt { flex-direction: column; padding: 40px 20px; gap: 30px; text-align: center; }
        .hero-left, .hero-visual, .feature-text, .feature-img { flex: none; width: 100%; }
        .hero-btns, .hero-trust { justify-content: center; }
        .roi-box { flex-direction: column; }
        .phone-flow { flex-direction: column; gap: 30px; }
        .stats { flex-direction: column; gap: 30px; padding: 40px 20px; }
        .stat-div { width: 80px; height: 1px; }
        .footer-grid { grid-template-columns: 1fr 1fr; gap: 30px; text-align: left; }
        .feature-img .mac-window { width: 100% !important; margin-top: 0 !important; align-self: center !important; }
        .tabs-nav { gap: 6px; }
        .tab-panel { flex-direction: column; }
        .get-started { padding: 40px 20px; }
      }
      @media (max-width: 600px) {
        .hero-left h1 { font-size: 28px; }
        .stat .num { font-size: 36px; }
        .section-h { font-size: 24px; }
        .footer-grid { grid-template-columns: 1fr; }
        .industry-grid { grid-template-columns: 1fr; }
      }
    </style>
  </Fragment>


  <!-- ══════════ ANNOUNCEMENT BAR ══════════ -->
  <div class="topbar">
    <span class="badge">✦ Official Meta Cloud API Partner</span>
    Meltiox is now live with WhatsApp Business API — Green Tick Verified &amp; Enterprise Ready.
    <a href="#">Learn more →</a>
  </div>


  <!-- ══════════ NAV ══════════ -->
  <nav>
    <div class="nav-logo">
      <svg viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="14" fill="#0a4f3f"/><path d="M7 20l1.5-5.5A7 7 0 1 1 14 21a7 7 0 0 1-3.5-.94L7 20z" fill="#fff"/></svg>
      Meltiox
    </div>
    <div class="nav-links">
      <a href="#features">Features</a>
      <a href="#showcase">Showcase</a>
      <a href="#industries">Industries</a>
      <a href="#roi">ROI Calculator</a>
      <a href="#faq">FAQs</a>
      <a href="/privacy-policy">Privacy</a>
      <a href="/terms-of-service">Terms</a>
    </div>
    <div class="nav-right">
      <a href="#" class="btn-demo">Book Demo</a>
      <a href="#" class="btn-green" style="padding: 9px 20px; font-size: 13px;">Start Free Trial</a>
    </div>
  </nav>


  <!-- ══════════ HERO ══════════ -->
  <section class="hero">
    <div class="hero-left">
      <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(37,211,102,0.12); border: 1px solid rgba(37,211,102,0.3); padding: 5px 14px; border-radius: 50px; font-size: 11px; font-weight: 700; color: #0a4f3f; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 18px;">
        <span style="width: 6px; height: 6px; border-radius: 50%; background: #25d366;"></span>
        #1 WhatsApp Marketing & CRM Platform
      </div>
      <h1>Turn WhatsApp Into Your<br><span class="gradient-text">#1 Sales & Revenue Machine</span></h1>
      <p>The all-in-one platform to automate WhatsApp marketing, sales, commerce & customer support. Build chatbots, broadcast campaigns, capture leads from Meta ads, and sell products — all inside WhatsApp.</p>
      <div class="hero-btns">
        <a href="#" class="btn-green">Start Free Trial →</a>
        <a href="#" class="btn-outline">Book a Demo</a>
